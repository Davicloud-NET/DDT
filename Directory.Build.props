<Project>

  <!-- DDT's version is Year.Major.Build. Year is the last two digits, because Windows Installer stops at 255. Major
       counts the releases with new features in that year. Build is not set here: it is the number of commits, which
       Directory.Build.targets and build/Get-Version.ps1 count. docs/install.md section 4.1. -->
  <PropertyGroup>
    <DdtVersionYear>26</DdtVersionYear>
    <DdtVersionMajor>1</DdtVersionMajor>
    <!-- A release passes the version it computed once, so that every file of it carries the same. -->
    <DdtVersionGiven Condition="'$(Version)' != ''">true</DdtVersionGiven>
  </PropertyGroup>

  <PropertyGroup Condition="'$(MSBuildProjectExtension)' != '.esproj' And '$(MSBuildProjectExtension)' != '.wixproj'">
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest</AnalysisLevel>
    <AccelerateBuildsInVisualStudio>true</AccelerateBuildsInVisualStudio>
    <!-- Binds without reflection. It skips a property with an init accessor without a warning, so options use set. -->
    <EnableConfigurationBindingGenerator>true</EnableConfigurationBindingGenerator>
    <!-- Only the rules .editorconfig turns on. -->
    <MeziantouAnalysisMode>None</MeziantouAnalysisMode>
  </PropertyGroup>

  <ItemGroup Condition="'$(MSBuildProjectExtension)' != '.esproj' And '$(MSBuildProjectExtension)' != '.wixproj'">
    <PackageReference Include="Meziantou.Analyzer" PrivateAssets="all" />
  </ItemGroup>

</Project>
