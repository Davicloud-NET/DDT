# Publishes the agent for Linux as one static file. NativeAOT does not compile across systems or C libraries, so the
# .NET SDK on Alpine compiles it against musl. build/Publish-LinuxAgent.ps1 runs this with the repository's root as
# the context:
#   docker build -f build/Dockerfile.agent-linux --target export --output artifacts/agent-linux .

# Alpine 3.24 with the .NET SDK 10.0.403. The digest is the tag's of 2026-11-05, so the image is the same every time.
ARG DOTNET_SDK=mcr.microsoft.com/dotnet/sdk:10.0-alpine@sha256:5562fd626eec39f6f53218f9b7d7856ab7195d51d846568304fbe85071a3b6e6

FROM ${DOTNET_SDK} AS build
# NativeAOT links with clang. StaticOpenSslLinking compiles the runtime's OpenSSL shim with cmake against the static
# libssl and libcrypto, which then are part of the agent, as musl is. THIRD-PARTY-NOTICES.md names both by the
# versions here. Alpine keeps only its newest build of a package, so this step fails once Alpine has a newer one,
# and the versions here and in the notices are moved on together.
ARG OPENSSL=3.5.9-r0
ARG MUSL=1.2.6-r3
RUN apk add --no-cache clang build-base cmake "openssl-dev=${OPENSSL}" "openssl-libs-static=${OPENSSL}" "musl-dev=${MUSL}"
WORKDIR /src
COPY global.json nuget.config Directory.Build.props Directory.Build.targets Directory.Packages.props .editorconfig ./
COPY src/DDT.ConsoleProtocol/DDT.ConsoleProtocol.csproj src/DDT.ConsoleProtocol/
COPY src/DDT.Contracts/DDT.Contracts.csproj src/DDT.Contracts/
COPY src/DDT.Core/DDT.Core.csproj src/DDT.Core/
COPY src/DDT.Agent.Core/DDT.Agent.Core.csproj src/DDT.Agent.Core/
COPY src/DDT.Agent.Linux/DDT.Agent.Linux.csproj src/DDT.Agent.Linux/
RUN --mount=type=cache,id=ddt-agent-linux-nuget,target=/root/.nuget/packages \
    dotnet restore src/DDT.Agent.Linux/DDT.Agent.Linux.csproj
COPY src/DDT.ConsoleProtocol/ src/DDT.ConsoleProtocol/
COPY src/DDT.Contracts/ src/DDT.Contracts/
COPY src/DDT.Core/ src/DDT.Core/
COPY src/DDT.Agent.Core/ src/DDT.Agent.Core/
COPY src/DDT.Agent.Linux/ src/DDT.Agent.Linux/
# The agent prints these, so they are compiled into it.
COPY LICENSE NOTICE THIRD-PARTY-NOTICES.md ./
COPY licenses/dotnet/ licenses/dotnet/
COPY licenses/gcc/ licenses/gcc/
COPY licenses/musl/ licenses/musl/
COPY licenses/openssl/ licenses/openssl/
COPY licenses/zstd/ licenses/zstd/
# The release's version, as 26.1.412. Nothing in here can count the commits, so without it Build is 0.
ARG DDT_VERSION
# Restores again: a restore layer from the build cache comes without the cache mount's packages.
RUN --mount=type=cache,id=ddt-agent-linux-nuget,target=/root/.nuget/packages \
    dotnet publish src/DDT.Agent.Linux/DDT.Agent.Linux.csproj -c Release -o /out ${DDT_VERSION:+-p:Version=$DDT_VERSION}
# The boot environment has no library to lend the agent, and the server reads the agent's version out of the file.
RUN if readelf -l -d /out/ddt-agent | grep -E 'INTERP|NEEDED'; then \
        echo "ddt-agent is not static: it names an interpreter or a library." >&2; exit 1; \
    fi; \
    if ! grep -a -q "DDT-AGENT-VERSION:${DDT_VERSION:-[0-9]}" /out/ddt-agent; then \
        echo "ddt-agent does not carry its version." >&2; exit 1; \
    fi

FROM scratch AS export
COPY --from=build /out/ddt-agent /ddt-agent
