<Project Sdk="Microsoft.NET.Sdk">

  <!-- Windows Installer runs managed custom actions on .NET Framework; 4.7.2 ships with Server 2019. -->
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AcceptEula>wix7</AcceptEula>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="CustomAction.config" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Management" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="WixToolset.Dtf.CustomAction" />
    <PackageReference Include="WixToolset.Dtf.WindowsInstaller" />
  </ItemGroup>

</Project>
