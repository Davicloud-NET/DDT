# Run once by busybox init before the agent starts: drivers, keyboard layout, clock, network, the server's name,
# and a wait for the disks.

. /usr/lib/ddt/common.sh

# Loads the driver of every device the kernel knows, and goes on while those drivers bring up new devices.
coldplug() {
    known=
    while :; do
        found=$(find /sys/devices -name modalias -type f -exec cat {} + 2> /dev/null | sort -u)
        if [ "$found" = "$known" ]; then
            break
        fi
        # One alias per line, ended by a zero byte for xargs: the DMI alias has spaces in it.
        echo "$found" | tr '\n' '\0' | xargs -0 modprobe -abq -- 2> /dev/null
        known=$found
    done
}

load_keymap() {
    keymap=$(argument ddt.keymap)
    case $keymap in
        "" | *[!a-z0-9-]*) return ;;
    esac
    if [ -f "/usr/share/ddt/keymaps/$keymap.bmap" ] && loadkmap < "/usr/share/ddt/keymaps/$keymap.bmap"; then
        stage "keyboard: layout $keymap"
    else
        stage "keyboard: no layout $keymap, staying with us"
    fi
}

# A flat battery or a clock years off makes the server's certificate look not yet valid or expired, and a machine
# that ran Windows keeps local time, which puts hours between the agent's lines and the server's. A clock within ten
# minutes stays: ddt.time is as old as the download took, and no time zone is that near.
set_clock() {
    server=$(argument ddt.time)
    case $server in
        "" | *[!0-9]*)
            stage "clock: no ddt.time on the kernel command line, so a wrong hardware clock stays wrong"
            return
            ;;
    esac
    # The shell would read a number with a leading zero as octal, and end this script at an 8 or a 9 in it.
    while [ "${server#0}" != "$server" ]; do
        server=${server#0}
    done
    # Seconds since 1970 have ten digits from 2001 to 2286.
    if [ "${#server}" != 10 ]; then
        stage "clock: ddt.time on the kernel command line is no time, so a wrong hardware clock stays wrong"
        return
    fi
    read -r uptime _ < /proc/uptime
    server=$((server + ${uptime%%.*}))
    off=$(($(date +%s) - server))
    if [ "$off" -gt 86400 ] || [ "$off" -lt -86400 ]; then
        date -s "@$server" > /dev/null
        stage "clock: the hardware clock was $((off / 86400)) days from the server's time, set from ddt.time"
    elif [ "$off" -gt 600 ] || [ "$off" -lt -600 ]; then
        date -s "@$server" > /dev/null
        stage "clock: the hardware clock was $((off / 60)) minutes from the server's time, set from ddt.time"
    else
        stage "clock: the hardware clock is $off s from the server's time, kept"
    fi
}

# The server's name must be found without DNS, and in lower case: the agent asks for it so, and /etc/hosts is
# compared by case.
add_server_name() {
    name=$(argument ddt.hostname | tr '[:upper:]' '[:lower:]')
    address=$(argument ddt.hostip)
    case $name in
        "" | *[!a-z0-9.-]*) return ;;
    esac
    case $address in
        "" | "$name" | *[!0-9a-fA-F.:]*) return ;;
    esac
    echo "$address $name" >> /etc/hosts
    stage "server: $name is $address"
}

disks() {
    for path in /sys/block/*; do
        if [ -e "$path" ]; then
            printf '%s ' "${path##*/}"
        fi
    done
}

# A controller that brings its disks up one after the other shows them late, and the agent takes the disks it finds
# for all there are. So the list has to stay as it is for 3 s, counted from when the drivers were loaded, which the
# network's start has mostly taken already. After 30 s the start goes on whatever the list does.
settle_disks() {
    read -r uptime _ < /proc/uptime
    still=$((${uptime%%.*} - disks_at))
    waited=0
    while :; do
        now=$(disks)
        if [ "$now" != "$disks_then" ]; then
            disks_then=$now
            still=0
        fi
        if [ "$still" -ge 3 ] || [ "$waited" -ge 30 ]; then
            break
        fi
        sleep 1
        still=$((still + 1))
        waited=$((waited + 1))
    done
    count=$(echo "$disks_then" | wc -w)
    if [ "$still" -ge 3 ]; then
        stage "disks: $count listed, and the list stayed so for $still s"
    else
        stage "disks: $count listed, and the list still changed after $waited s"
    fi
}

echo ddt > /proc/sys/kernel/hostname
ip link set lo up

stage "drivers: loading"
# mdev stays and loads the drivers of what arrives later, such as USB devices.
mdev -d
coldplug
disks_then=$(disks)
read -r uptime _ < /proc/uptime
disks_at=${uptime%%.*}
stage "drivers: $(wc -l < /proc/modules) modules loaded"

load_keymap
set_clock
/usr/lib/ddt/network
add_server_name
settle_disks
stage "start: done, the agent is next"
