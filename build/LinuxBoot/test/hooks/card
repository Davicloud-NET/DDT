# Run by the placeholder agent in the card check: what the kernel says of each SD or eMMC card, which is what the
# agent tells a card in a reader from a disk that is built in by.

PATH=/usr/bin
export PATH

for path in /sys/block/mmcblk*; do
    if [ -e "$path/size" ]; then
        echo "card: ${path##*/} removable=$(cat "$path/removable") ro=$(cat "$path/ro") size=$(cat "$path/size")" \
            "type=$(cat "$path/device/type") name=$(cat "$path/device/name") at=$(readlink -f "$path")"
    fi
done
echo "card: listed"
