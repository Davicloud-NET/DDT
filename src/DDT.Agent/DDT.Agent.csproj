<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>Exe</OutputType>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <IsAotCompatible>true</IsAotCompatible>
    <AssemblyName>ddt-agent</AssemblyName>
    <!-- Required by the LibraryImport source generator. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DefineConstants Condition="'$(_IsPublishing)' == 'true'">$(DefineConstants);DDT_PUBLISHED</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DDT.Contracts\DDT.Contracts.csproj" />
    <ProjectReference Include="..\DDT.Core\DDT.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Only libwim-15.dll, never the managed wrapper. The agent carries it inside the executable, so the boot image
         and the self-update stay one file; WimLibraryFile writes it out before the first wimlib call, unless a
         libwim-15.dll is already next to the agent. -->
    <PackageReference Include="ManagedWimLib" IncludeAssets="native" GeneratePathProperty="true" />
    <EmbeddedResource Include="$(PkgManagedWimLib)\runtimes\win-x64\native\libwim-15.dll" LogicalName="libwim-15.dll" />
  </ItemGroup>

  <ItemGroup>
    <!-- The legal texts the agent prints, under the names AgentLegalNotices.Files lists. -->
    <EmbeddedResource Include="..\..\NOTICE;..\..\LICENSE;..\..\THIRD-PARTY-NOTICES.md" LogicalName="%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\..\licenses\dotnet\*" LogicalName="licenses/dotnet/%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\..\licenses\wimlib\*" LogicalName="licenses/wimlib/%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
