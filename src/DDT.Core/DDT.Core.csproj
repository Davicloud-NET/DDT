<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsAotCompatible>true</IsAotCompatible>
    <!-- Required by the LibraryImport source generator. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DDT.Contracts\DDT.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The script a hand-over to the installed Linux puts on the cloud-init seed. VendorDataScript reads it. -->
    <EmbeddedResource Include="CloudInit\vendor-data.sh" LogicalName="cloud-init/vendor-data.sh" />
  </ItemGroup>

</Project>
