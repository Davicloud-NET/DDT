{
  "$description": "The Switchgear design tokens, the one source of DDT's look. generate.mjs turns them into the web theme and the resources of the console in Windows PE. Colour names say what a colour is for, never what it looks like.",
  "font": {
    "sans": ["Archivo Variable", "Archivo", "Segoe UI", "system-ui", "sans-serif"],
    "mono": ["Martian Mono Variable", "Martian Mono", "Cascadia Mono", "Consolas", "monospace"]
  },
  "type": {
    "$description": "Archivo carries every width, so one family does display, headings and body. Mono is only for identifiers and logs.",
    "wordmark": { "size": "21px", "lineHeight": "1", "weight": 800, "stretch": "72%" },
    "display": { "size": "64px", "lineHeight": "0.82", "weight": 750, "stretch": "62%", "letterSpacing": "-0.02em" },
    "title": { "size": "42px", "lineHeight": "0.95", "weight": 750, "stretch": "70%", "letterSpacing": "-0.01em" },
    "subtitle": { "size": "28px", "lineHeight": "1", "weight": 750, "stretch": "72%", "letterSpacing": "-0.005em" },
    "heading": { "size": "20px", "lineHeight": "1.2", "weight": 700, "stretch": "78%" },
    "label": { "size": "15px", "lineHeight": "1.3", "weight": 650, "stretch": "80%" },
    "body": { "size": "14px", "lineHeight": "1.45", "weight": 400, "stretch": "100%" },
    "small": { "size": "13px", "lineHeight": "1.4", "weight": 400, "stretch": "100%" },
    "numeral": { "size": "15px", "lineHeight": "1.2", "weight": 700, "stretch": "70%" },
    "step": { "size": "15px", "lineHeight": "1.2", "weight": 500, "stretch": "85%" },
    "tag": { "size": "13px", "lineHeight": "1", "weight": 750, "stretch": "75%", "letterSpacing": "0.02em", "transform": "uppercase" },
    "data": { "family": "mono", "size": "12.5px", "lineHeight": "1.5", "weight": 400, "stretch": "87.5%" }
  },
  "radius": {
    "$description": "Corners grow with the part.",
    "tag": "2px",
    "key": "4px",
    "panel": "6px",
    "overlay": "8px"
  },
  "motion": {
    "$description": "Motion answers an action or a change of state and never decorates. It is short and mechanical, with no overshoot: things enter decelerating and leave accelerating, travel a few pixels at most, and change only opacity and position, which the console's software renderer draws cheaply. Only something that runs keeps moving.",
    "press": "70ms",
    "fast": "120ms",
    "normal": "160ms",
    "slow": "240ms",
    "flash": "1400ms",
    "distance": "6px",
    "easing": "cubic-bezier(0.2, 0, 0.13, 1)",
    "enter": "cubic-bezier(0, 0, 0.2, 1)",
    "exit": "cubic-bezier(0.4, 0, 1, 1)"
  },
  "color": {
    "$description": "Semantic colours per theme. Surfaces get lighter as they come forward in both themes; only overlays cast a shadow. Signal colours follow the RAL signal colours and mark state only.",
    "light": {
      "frame": "#2A2E31",
      "frame-text": "#E6E9E6",
      "frame-muted": "#AAB1B3",
      "frame-line": "#3C4245",
      "frame-hover": "#34393C",
      "frame-logo": "#F08A8A",
      "page": "#DCDFDB",
      "panel": "#F7F8F6",
      "raised": "#FFFFFF",
      "well": "#ECEEEA",
      "field": "#FFFFFF",
      "hover": "#EEF0EC",
      "selected": "#E6ECF4",
      "line": "#CCD1CD",
      "line-soft": "#E4E7E3",
      "control": "#7D8588",
      "ink": "#1F2426",
      "ink-2": "#454D51",
      "muted": "#566064",
      "placeholder": "#6B7478",
      "inverse": "#F7F8F6",
      "run": "#1F5AA6",
      "run-text": "#1F5AA6",
      "run-soft": "rgb(31 90 166 / 0.08)",
      "attention": "#F2A900",
      "on-attention": "#1F2426",
      "attention-text": "#7A5300",
      "fail": "#C22A2F",
      "on-fail": "#FFFFFF",
      "fail-text": "#B3262B",
      "ok": "#22774D",
      "on-ok": "#FFFFFF",
      "ok-text": "#1E6B45",
      "key-primary": "#1F2426",
      "key-primary-hover": "#384044",
      "on-key-primary": "#F7F8F6",
      "key-secondary": "#FFFFFF",
      "key-secondary-hover": "#F0F2EF",
      "rail-done": "#4D565A",
      "rail-edge": "#AEB4B0",
      "rail-stripe": "rgb(255 255 255 / 0.16)",
      "focus": "#1F5AA6",
      "console": "#1B1E20",
      "console-text": "#D9DDDA",
      "console-muted": "#A0A8AC",
      "console-line": "#2C3134",
      "console-attention": "#F2B84B",
      "console-fail": "#F28B82",
      "console-selected": "#2A3036",
      "backdrop": "rgb(21 24 26 / 0.45)",
      "edge-panel": "rgb(31 36 38 / 0.09)",
      "edge-overlay": "rgb(31 36 38 / 0.08)",
      "shadow-overlay": "rgb(31 36 38 / 0.20)",
