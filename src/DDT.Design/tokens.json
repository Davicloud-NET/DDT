      "frame-line": "#2A2F32",
      "frame-hover": "#1F2326",
      "frame-logo": "#F08A8A",
      "page": "#1D2123",
      "panel": "#262B2E",
      "raised": "#30363A",
      "well": "#1F2326",
      "field": "#1F2326",
      "hover": "#2C3236",
      "selected": "#28323C",
      "line": "#394044",
      "line-soft": "#30363A",
      "control": "#7C868B",
      "ink": "#E8EAE7",
      "ink-2": "#C3C8C6",
      "muted": "#A0A8AC",
      "placeholder": "#8E979B",
      "inverse": "#1D2123",
      "run": "#2D6CC9",
      "run-text": "#8DB6F2",
      "run-soft": "rgb(88 146 230 / 0.10)",
      "attention": "#F2B21B",
      "on-attention": "#1D2123",
      "attention-text": "#F2C35A",
      "fail": "#D1383E",
      "on-fail": "#FFFFFF",
      "fail-text": "#F08D8F",
      "ok": "#25784F",
      "on-ok": "#FFFFFF",
      "ok-text": "#7FCFA3",
      "key-primary": "#E8EAE7",
      "key-primary-hover": "#FFFFFF",
      "on-key-primary": "#1D2123",
      "key-secondary": "#30363A",
      "key-secondary-hover": "#373E43",
      "rail-done": "#A0A8AC",
      "rail-edge": "#4A5357",
      "rail-stripe": "rgb(255 255 255 / 0.12)",
      "focus": "#8DB6F2",
      "console": "#141618",
      "console-text": "#D9DDDA",
      "console-muted": "#A0A8AC",
      "console-line": "#2C3134",
      "console-attention": "#F2B84B",
      "console-fail": "#F28B82",
      "console-selected": "#2A3036",
      "backdrop": "rgb(0 0 0 / 0.55)",
      "edge-panel": "rgb(255 255 255 / 0.06)",
      "edge-overlay": "rgb(255 255 255 / 0.08)",
      "shadow-overlay": "rgb(0 0 0 / 0.55)",
      "logo-ring": "#F08A8A"
    }
  },
  "contrast": {
    "$description": "Pairs the generator checks in both themes: [text, background, minimum ratio]. 4.5 for text, 3 for control edges and large text.",
    "pairs": [
      ["ink", "page", 4.5], ["ink", "panel", 4.5], ["ink", "raised", 4.5], ["ink", "well", 4.5], ["ink", "selected", 4.5],
      ["ink-2", "page", 4.5], ["ink-2", "panel", 4.5], ["ink-2", "raised", 4.5],
      ["muted", "page", 4.5], ["muted", "panel", 4.5], ["muted", "raised", 4.5], ["muted", "hover", 4.5],
      ["placeholder", "field", 4.5],
      ["frame-text", "frame", 4.5], ["frame-muted", "frame", 4.5], ["frame-text", "frame-hover", 4.5],
      ["run-text", "panel", 4.5], ["fail-text", "panel", 4.5], ["ok-text", "panel", 4.5], ["attention-text", "panel", 4.5],
      ["on-attention", "attention", 4.5], ["on-fail", "fail", 4.5], ["on-ok", "ok", 4.5], ["white", "run", 4.5],
      ["on-key-primary", "key-primary", 4.5], ["ink", "key-secondary", 4.5],
      ["console-text", "console", 4.5], ["console-muted", "console", 4.5],
      ["console-attention", "console", 4.5], ["console-fail", "console", 4.5], ["console-text", "console-selected", 4.5],
      ["control", "field", 3], ["control", "panel", 3], ["focus", "panel", 3]
    ]
  }
}
