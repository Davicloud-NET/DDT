<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <ApplicationIcon>..\DDT.Design\brand\ddt-logo.ico</ApplicationIcon>
    <UserSecretsId>aspnet-DDT_Host-a077d2f4-d71b-4918-bf26-a74c1cb9a3c4</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DDT.Pxe\DDT.Pxe.csproj" />
    <ProjectReference Include="..\DDT.Server\DDT.Server.csproj" />
    <ProjectReference Include="..\DDT.ServiceDefaults\DDT.ServiceDefaults.csproj" />
  </ItemGroup>

  <!-- The licence texts travel with every copy of the server, and the About page serves them from this folder. -->
  <ItemGroup>
    <Content Include="..\..\LICENSE;..\..\NOTICE;..\..\THIRD-PARTY-NOTICES.md"
             Link="legal\%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\licenses\**"
             Link="legal\licenses\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
