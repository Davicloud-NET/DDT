<!-- The Switchgear tokens and the console's themes, on top of Avalonia's simple theme. Dark by default, like WinPE's
     screens. -->
<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="DDT.MachineConsole.App"
             RequestedThemeVariant="Dark">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://DDT.MachineConsole/Theme/Tokens.axaml" />
        <ResourceInclude Source="avares://DDT.MachineConsole/Theme/Console.axaml" />
        <ResourceInclude Source="avares://DDT.MachineConsole/Theme/Controls.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <SimpleTheme />
    <StyleInclude Source="avares://DDT.MachineConsole/Theme/Type.axaml" />
    <StyleInclude Source="avares://DDT.MachineConsole/Theme/Surfaces.axaml" />
  </Application.Styles>
</Application>
