<Project Sdk="Microsoft.NET.Sdk">

  <!-- The console's screens, texts and theme, shared by the heads that start it: DDT.MachineConsole.Windows builds
       ddt-console.exe. It references only the console protocol, never the agent. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>DDT.MachineConsole</RootNamespace>
    <IsAotCompatible>true</IsAotCompatible>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DDT.ConsoleProtocol\DDT.ConsoleProtocol.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.HarfBuzz" />
    <PackageReference Include="Avalonia.Skia" />
    <PackageReference Include="Avalonia.Themes.Simple" />
    <!-- Avalonia.BuildServices sends statistics about each build, so its targets are left out. -->
    <PackageReference Include="Avalonia.BuildServices" ExcludeAssets="all" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\Fonts\*.ttf" />
    <AvaloniaResource Include="Assets\ddt-logo.png" />
    <!-- The console's texts, under the names Catalogs.ResourceName looks for. -->
    <EmbeddedResource Include="Locales\en\messages.po" LogicalName="locales/en/messages.po" />
    <EmbeddedResource Include="Locales\de\messages.po" LogicalName="locales/de/messages.po" />
    <!-- The legal texts the licences view shows, under the names LegalTexts.Documents lists. -->
    <EmbeddedResource Include="..\..\NOTICE;..\..\LICENSE" LogicalName="%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\..\licenses\avalonia\*" LogicalName="licenses/avalonia/%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\..\licenses\microcom\*" LogicalName="licenses/microcom/%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\..\licenses\skiasharp\*" LogicalName="licenses/skiasharp/%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\..\licenses\dotnet\*" LogicalName="licenses/dotnet/%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\..\licenses\fonts\*" LogicalName="licenses/fonts/%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
