<!-- Console-only resources next to the generated Tokens.axaml: the sizes of large text that's read from across a
     room, and the rows that show facts. -->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="using:DDT.MachineConsole.ViewModels">
  <x:Double x:Key="ConsoleHeroSize">184</x:Double>
  <x:Double x:Key="ConsoleHeroSignSize">88</x:Double>
  <x:Double x:Key="ConsoleHeadlineSize">54</x:Double>
  <x:Double x:Key="ConsoleSequenceSize">21</x:Double>
  <x:Double x:Key="ConsoleLeadSize">17</x:Double>
  <x:Double x:Key="ConsoleIdentifierSize">20</x:Double>
  <x:Double x:Key="ConsoleKeySize">15</x:Double>
  <x:Double x:Key="ConsoleKeyHeight">40</x:Double>
  <x:Double x:Key="ConsoleFieldHeight">44</x:Double>

  <!-- How much a pressed key, and a key cap whose key is down, darken in both themes. -->
  <SolidColorBrush x:Key="ConsolePressShade" Color="#26000000" />

  <!-- A fact: its label above and its value below. Identifiers use the mono font. -->
  <DataTemplate x:Key="FactRow" x:DataType="vm:Fact">
    <StackPanel Spacing="2" Margin="0,0,0,10">
      <TextBlock Classes="small muted" Text="{Binding Label}" />
      <TextBlock Text="{Binding Value}" FontSize="17" Classes.identifier="{Binding Mono}" />
    </StackPanel>
  </DataTemplate>

  <!-- A fact in a table: its label beside its value. -->
  <DataTemplate x:Key="FactLine" x:DataType="vm:Fact">
    <Grid ColumnDefinitions="170,*" Margin="0,0,0,6">
      <TextBlock Classes="body muted" Text="{Binding Label}" />
      <TextBlock Grid.Column="1" Classes="body" Classes.data="{Binding Mono}" Text="{Binding Value}" />
    </Grid>
  </DataTemplate>
</ResourceDictionary>
