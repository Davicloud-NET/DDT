<!-- The agent's log on the console well, as the web's log panel shows it: time, level and text, newest last. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DDT.MachineConsole.ViewModels"
             xmlns:c="using:DDT.MachineConsole.Controls"
             x:Class="DDT.MachineConsole.Views.LogView"
             x:DataType="vm:LogViewModel">
  <UserControl.Styles>
    <Style Selector="TextBlock.logLevel.warning">
      <Setter Property="Foreground" Value="{DynamicResource SgConsoleAttention}" />
    </Style>
    <Style Selector="TextBlock.logLevel.error">
      <Setter Property="Foreground" Value="{DynamicResource SgConsoleFail}" />
    </Style>
  </UserControl.Styles>
  <Grid RowDefinitions="Auto,*" Margin="22,18,22,22" RowSpacing="14">
    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
      <StackPanel Spacing="2">
        <TextBlock Name="Title" Classes="heading" Text="{Binding Title}" />
        <TextBlock Classes="small muted" Text="{Binding Hint}" />
      </StackPanel>
      <Button Grid.Column="1" Classes="quiet" Name="FollowButton" Click="OnFollow" Focusable="False">
        <StackPanel Orientation="Horizontal" Spacing="10">
          <c:KeyCap Key="End" />
          <TextBlock Text="{Binding FollowLabel}" VerticalAlignment="Center" />
        </StackPanel>
      </Button>
      <Button Grid.Column="2" Classes="quiet" Name="CloseButton" Command="{Binding CloseCommand}" Focusable="False">
        <StackPanel Orientation="Horizontal" Spacing="10">
          <c:KeyCap Key="Esc" />
          <TextBlock Text="{Binding CloseLabel}" VerticalAlignment="Center" />
        </StackPanel>
      </Button>
    </Grid>

    <Border Grid.Row="1" Classes="console" Padding="4">
      <Panel>
        <TextBlock Classes="data" Margin="12" Foreground="{DynamicResource SgConsoleMuted}" Text="{Binding Empty}" IsVisible="{Binding IsEmpty}" />
        <ScrollViewer Name="Scroller" Focusable="True" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
          <ItemsControl Name="Lines" ItemsSource="{Binding Lines}" Margin="10,6">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <VirtualizingStackPanel />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="vm:LogLine">
                <Grid ColumnDefinitions="78,92,*" Margin="0,1">
                  <TextBlock Classes="data" Foreground="{DynamicResource SgConsoleMuted}" Text="{Binding Time}" TextWrapping="NoWrap" />
                  <TextBlock Grid.Column="1"
                             Classes="data logLevel"
                             Classes.warning="{Binding IsWarning}"
                             Classes.error="{Binding IsError}"
                             Foreground="{DynamicResource SgConsoleMuted}"
                             Text="{Binding Level}"
                             TextWrapping="NoWrap" />
                  <TextBlock Grid.Column="2" Classes="data" Foreground="{DynamicResource SgConsoleText}" Text="{Binding Text}" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Panel>
    </Border>
  </Grid>
</UserControl>
