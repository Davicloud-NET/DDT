<!-- DDT's mark, cropped from src/DDT.Design/brand/ddt-logo.png to the mark and 256 pixels high. Avalonia can't draw
     SVG without another package, and an image keeps the mark's gradients exactly as drawn. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="DDT.MachineConsole.Views.Logo">
  <Image Source="avares://ddt-console/Assets/ddt-logo.png"
         Stretch="Uniform"
         RenderOptions.BitmapInterpolationMode="HighQuality" />
</UserControl>
