<!-- The console's one window: the frame with the machine and the connection on top, the screen of the stage or the
     question in the middle, and the machine's network and the keys that work everywhere at the bottom. The log, the
     machine's details and the licences open over the screen. -->
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DDT.MachineConsole.ViewModels"
        xmlns:v="using:DDT.MachineConsole.Views"
        xmlns:c="using:DDT.MachineConsole.Controls"
        x:Class="DDT.MachineConsole.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="DDT"
        Width="1280"
        Height="800"
        MinWidth="640"
        MinHeight="480"
        TextOptions.TextRenderingMode="Antialias">
  <c:ScreenScaler>
    <Grid RowDefinitions="56,Auto,*,50">

      <!-- The frame. -->
      <Border Grid.Row="0" Classes="frame" Padding="28,0">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
            <v:Logo Width="26" Height="26" />
            <TextBlock Classes="wordmark" Text="DDT" Foreground="{DynamicResource SgFrameText}" VerticalAlignment="Center" />
            <Rectangle Width="1" Height="24" Margin="6,0" Fill="{DynamicResource SgFrameLine}" />
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center" ClipToBounds="True">
            <TextBlock Name="MachineLabel"
                       Text="{Binding MachineLabel}"
                       FontFamily="{DynamicResource SgTypeHeadingFamily}"
                       FontSize="22"
                       TextWrapping="NoWrap"
                       TextTrimming="CharacterEllipsis"
                       Foreground="{DynamicResource SgFrameText}"
                       VerticalAlignment="Center" />
            <c:StateTag Value="{Binding DryRunTag}" IsVisible="{Binding IsDryRun}" />
          </StackPanel>
          <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Name="Connection"
                       Margin="16,0,0,0"
                       Text="{Binding Connection}"
                       FontSize="15"
                       TextWrapping="NoWrap"
                       Foreground="{DynamicResource SgFrameMuted}"
                       VerticalAlignment="Center" />
            <!-- The organisation's logo, uploaded on the Deployment defaults page. -->
            <StackPanel Orientation="Horizontal" IsVisible="{Binding HasLogo}">
              <Rectangle Width="1" Height="24" Margin="18,0" Fill="{DynamicResource SgFrameLine}" VerticalAlignment="Center" />
              <Image Name="CustomLogo"
                     Source="{Binding Logo}"
                     MaxHeight="32"
                     MaxWidth="200"
                     Stretch="Uniform"
                     RenderOptions.BitmapInterpolationMode="HighQuality"
                     VerticalAlignment="Center" />
            </StackPanel>
          </StackPanel>
        </Grid>
      </Border>

      <!-- Once the pipe has ended, or in DDT's session once the run is over: the last state stays below, and the way on
           is here. -->
      <Border Grid.Row="1" Classes="raised" Name="EndedBand" c:Motion.Shown="{Binding ShowsEndBand}" Margin="36,20,36,0" Padding="22,16">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Spacing="4" VerticalAlignment="Center">
            <TextBlock Classes="heading" Text="{Binding EndedTitle}" />
            <TextBlock Classes="body ink2" Text="{Binding EndedText}" />
            <TextBlock Classes="small muted" Text="{Binding RestartUnavailable}" IsVisible="{Binding ShowsRestartUnavailable}" />
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center" Margin="20,0,0,0">
            <Button Name="EndedPrompt" Classes="quiet" Command="{Binding OpenPromptCommand}" IsVisible="{Binding CanOpenPrompt}">
              <StackPanel Orientation="Horizontal" Spacing="10">
                <StackPanel Orientation="Horizontal" Spacing="4">
                  <c:KeyCap Key="Shift" />
                  <c:KeyCap Key="F10" />
                </StackPanel>
                <TextBlock Text="{Binding PromptLabel}" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button Name="CloseConsole" Command="{Binding CloseCommand}">
              <StackPanel Orientation="Horizontal" Spacing="10">
                <c:KeyCap Key="F9" />
                <TextBlock Text="{Binding CloseLabel}" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button Name="Restart" Classes="primary" Command="{Binding RestartCommand}" IsVisible="{Binding CanRestart}">
              <StackPanel Orientation="Horizontal" Spacing="10">
                <c:KeyCap Key="F8" />
                <TextBlock Text="{Binding RestartLabel}" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </StackPanel>
        </Grid>
      </Border>

      <!-- The screen of the stage, or the question, which gives way to the next as it comes. -->
      <TransitioningContentControl Grid.Row="2" Name="Screen" Content="{Binding Screen}" Margin="36,20,36,20">
        <TransitioningContentControl.PageTransition>
          <c:ScreenTransition />
        </TransitioningContentControl.PageTransition>
        <TransitioningContentControl.DataTemplates>
          <DataTemplate DataType="vm:ConnectionViewModel">
            <v:ConnectionView />
          </DataTemplate>
          <DataTemplate DataType="vm:AuthorizationViewModel">
            <v:AuthorizationView />
          </DataTemplate>
          <DataTemplate DataType="vm:WaitingViewModel">
            <v:WaitingView />
          </DataTemplate>
          <DataTemplate DataType="vm:RunViewModel">
            <v:RunView />
          </DataTemplate>
          <DataTemplate DataType="vm:SequenceChoiceViewModel">
            <v:SequenceChoiceView />
          </DataTemplate>
          <DataTemplate DataType="vm:DiskChoiceViewModel">
            <v:DiskChoiceView />
          </DataTemplate>
          <DataTemplate DataType="vm:ComputerNameViewModel">
            <v:ComputerNameView />
          </DataTemplate>
          <DataTemplate DataType="vm:EraseViewModel">
            <v:EraseView />
          </DataTemplate>
          <DataTemplate DataType="vm:SecureBootViewModel">
            <v:SecureBootView />
          </DataTemplate>
          <DataTemplate DataType="vm:InputsViewModel">
            <v:InputsView />
          </DataTemplate>
          <DataTemplate DataType="vm:PauseViewModel">
            <v:PauseView />
          </DataTemplate>
        </TransitioningContentControl.DataTemplates>
      </TransitioningContentControl>

      <!-- A short note with the keys it names: hold Fn when a laptop's top row sends media keys, or why the console
           stays open when someone tries to close it. -->
      <Border Grid.Row="2"
              Name="Notice"
              Classes="raised"
              c:Motion.Shown="{Binding HasNotice}"
              HorizontalAlignment="Center"
              VerticalAlignment="Bottom"
              Margin="36,0,36,20"
              Padding="18,12">
        <StackPanel Orientation="Horizontal" Spacing="12">
          <ItemsControl ItemsSource="{Binding NoticeKeys}" VerticalAlignment="Center">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" Spacing="4" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="x:String">
                <c:KeyCap Key="{Binding}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Classes="body" Text="{Binding NoticeText}" TextWrapping="Wrap" MaxWidth="760" VerticalAlignment="Center" />
        </StackPanel>
      </Border>

      <!-- The log, the machine's details or the licences, over the screen. The window sets what it shows, and keeps it
           while the overlay leaves. -->
      <c:Backdrop Grid.Row="1" Grid.RowSpan="2" Name="OverlayBackdrop" c:Motion.Shown="{Binding HasOverlay}" c:Motion.Rises="False" />
      <Panel Grid.Row="1" Grid.RowSpan="2" Name="Overlay" c:Motion.Shown="{Binding HasOverlay}" Margin="24,18,24,18">
        <Border Classes="overlayShadow">
          <Border.CacheMode>
            <BitmapCache />
          </Border.CacheMode>
        </Border>
        <Border Classes="overlay">
          <TransitioningContentControl Name="OverlayPages">
            <TransitioningContentControl.DataTemplates>
              <DataTemplate DataType="vm:LogViewModel">
                <v:LogView />
              </DataTemplate>
              <DataTemplate DataType="vm:MachineViewModel">
                <v:MachineView />
              </DataTemplate>
              <DataTemplate DataType="vm:LicencesViewModel">
                <v:LicencesView />
              </DataTemplate>
            </TransitioningContentControl.DataTemplates>
          </TransitioningContentControl>
        </Border>
      </Panel>

      <!-- The footer. -->
      <Border Grid.Row="3" Classes="footer">
        <Grid ColumnDefinitions="*,Auto">
          <ItemsControl ItemsSource="{Binding FooterFacts}" ClipToBounds="True" Margin="8,0,0,0">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="vm:Fact">
                <Border BorderBrush="{DynamicResource SgLineSoft}" BorderThickness="0,0,1,0" Padding="20,0" Height="49">
                  <TextBlock Text="{Binding Value}"
                             Classes="ink2"
                             Classes.footerData="{Binding Mono}"
                             FontSize="14"
                             TextWrapping="NoWrap"
                             VerticalAlignment="Center" />
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <ItemsControl Grid.Column="1" ItemsSource="{Binding Keys}" Margin="0,0,20,0" VerticalAlignment="Center">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" Spacing="4" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="vm:KeyHint">
                <Button Classes="footerKey" Classes.active="{Binding IsActive}" Command="{Binding Command}" Focusable="False">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <c:KeyCap Key="{Binding Key}" />
                    <TextBlock Text="{Binding Label}" TextWrapping="NoWrap" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Grid>
      </Border>

      <!-- Asked before the console restarts the machine. -->
      <c:Backdrop Grid.Row="0" Grid.RowSpan="4" Name="ConfirmBackdrop" c:Motion.Shown="{Binding ConfirmingRestart}" c:Motion.Rises="False" />
      <Panel Grid.Row="0"
             Grid.RowSpan="4"
             Name="Confirm"
             c:Motion.Shown="{Binding ConfirmingRestart}"
             Width="520"
             HorizontalAlignment="Center"
             VerticalAlignment="Center">
        <Border Classes="overlayShadow">
          <Border.CacheMode>
            <BitmapCache />
          </Border.CacheMode>
        </Border>
        <Border Classes="overlay" Padding="24">
          <StackPanel Spacing="16">
            <TextBlock Classes="heading" Text="{Binding ConfirmTitle}" />
            <TextBlock Classes="body ink2" Text="{Binding ConfirmText}" />
            <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right">
              <Button Command="{Binding CancelRestartCommand}">
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <c:KeyCap Key="Esc" />
                  <TextBlock Text="{Binding CancelLabel}" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <Button Classes="primary" Command="{Binding ConfirmRestartCommand}">
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <c:KeyCap Key="Enter" />
                  <TextBlock Text="{Binding ConfirmLabel}" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
            </StackPanel>
          </StackPanel>
        </Border>
      </Panel>
    </Grid>
  </c:ScreenScaler>
</Window>
