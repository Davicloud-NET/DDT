        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="DDT.MachineConsole.Views.MainWindow"
        Title="DDT"
        Width="1280"
        Height="800"
        MinWidth="640"
        MinHeight="480"
        TextOptions.TextRenderingMode="Antialias" />
