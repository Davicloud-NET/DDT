msgid "{activity}, last contact {contact}"
msgstr "{activity}, letzter Kontakt {contact}"

#: src/lib/serverMessages.ts
msgctxt "settings.oidc.provisionAdministrator"
msgid "{administrator} would make every identity the provider signs in that DDT has not seen an administrator. Use {viewer} or {operator}, or map a group to {administrator} in GroupRoleMap."
msgstr "{administrator} würde jede Identität, die der Anbieter anmeldet und die DDT noch nicht kennt, zum Administrator machen. Verwenden Sie {viewer} oder {operator}, oder ordnen Sie in GroupRoleMap eine Gruppe {administrator} zu."

#: src/lib/serverMessages.ts
msgctxt "application.dependencyGone"
msgid "{application} depends on an application that is no longer in the library."
msgstr "{application} hängt von einer Anwendung ab, die nicht mehr in der Bibliothek ist."

#: src/lib/serverMessages.ts
msgctxt "sequence.wingetNeedsSession"
msgid "{application} installs with winget, which needs a Write answer file step."
msgstr "{application} wird mit winget installiert, das einen Schritt „Antwortdatei schreiben“ braucht."

#: src/lib/serverMessages.ts
msgctxt "deployment.applicationDependencyGone"
msgid "{application}, which {step} installs, depends on an application that is no longer in the library."
msgstr "{application}, das {step} installiert, braucht eine Anwendung, die nicht mehr in der Bibliothek ist."

