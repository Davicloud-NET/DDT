msgstr "Der Eintrag {entry} hat einen Namen, der auf einen Punkt oder ein Leerzeichen endet, was Windows nicht anlegen kann."

#: src/lib/serverMessages.ts
msgctxt "package.entryDeviceName"
msgid "The entry {entry} has a name Windows keeps for a device, such as CON or NUL."
msgstr "Der Eintrag {entry} hat einen Namen, den Windows für ein Gerät reserviert, etwa CON oder NUL."

#: src/lib/serverMessages.ts
msgctxt "package.entryEmptyName"
msgid "The entry {entry} has an empty name, or a folder name that points out of the package."
msgstr "Der Eintrag {entry} hat einen leeren Namen oder einen Ordnernamen, der aus dem Paket hinauszeigt."

#: src/lib/serverMessages.ts
msgctxt "package.entrySymbolicLink"
msgid "The entry {entry} is a symbolic link. Put the file itself in the zip."
msgstr "Der Eintrag {entry} ist ein symbolischer Link. Legen Sie die Datei selbst in die ZIP-Datei."

#: src/lib/serverMessages.ts
msgctxt "package.entryCompression"
msgid "The entry {entry} is compressed in a way DDT cannot unpack. Create the zip with Deflate."
msgstr "Der Eintrag {entry} ist so komprimiert, dass DDT ihn nicht entpacken kann. Erstellen Sie die ZIP-Datei mit Deflate."

#: src/lib/serverMessages.ts
msgctxt "package.entryDamaged"
msgid "The entry {entry} is damaged. Create the zip again."
msgstr "Der Eintrag {entry} ist beschädigt. Erstellen Sie die ZIP-Datei neu."

#: src/lib/serverMessages.ts
msgctxt "package.entryEncrypted"
msgid "The entry {entry} is encrypted. Upload a zip without a password."
msgstr "Der Eintrag {entry} ist verschlüsselt. Laden Sie eine ZIP-Datei ohne Kennwort hoch."

#: src/lib/serverMessages.ts
msgctxt "package.entryTwice"
msgid "The entry {entry} is in the zip twice, if case is ignored as Windows ignores it."
msgstr "Der Eintrag {entry} ist zweimal in der ZIP-Datei, wenn man wie Windows die Groß- und Kleinschreibung ignoriert."

#: src/lib/serverMessages.ts
msgctxt "package.entryTooDeep"
msgid "The entry {entry} is more than {max} folders deep."
msgstr "Der Eintrag {entry} liegt mehr als {max} Ordner tief."

#: src/lib/serverMessages.ts
msgctxt "package.entryAtRoot"
msgid "The entry {entry} starts at the root of a drive."
msgstr "Der Eintrag {entry} beginnt im Stammverzeichnis eines Laufwerks."

#: src/lib/serverMessages.ts
msgctxt "package.entrySize"
msgid "The entry {entry} unpacks to {actual} bytes, but the zip says {declared}. Create the zip again."
msgstr "Der Eintrag {entry} entpackt zu {actual} Bytes, aber die ZIP-Datei gibt {declared} an. Erstellen Sie die ZIP-Datei neu."

#: src/lib/serverMessages.ts
msgctxt "directory.noImmutableId"
msgid "The entry has no {attribute} value to key the account on, so a sign-in is refused."
msgstr "Der Eintrag hat keinen Wert {attribute}, an den das Konto gebunden werden kann, daher wird eine Anmeldung abgelehnt."

#: src/settings/networkBoot/SectionProblems.tsx
msgid "The fields marked below say what."
msgstr "Die markierten Felder unten sagen, welche."

#: src/settings/AgentPanel.tsx
msgid "The file DDT:Agent:BinaryPath names in configuration"
msgstr "Die Datei, die DDT:Agent:BinaryPath in der Konfiguration benennt"

#: src/lib/serverMessages.ts
msgctxt "gpt.noTable"
msgid "The file has no GUID partition table, so it is not a UEFI disk image. Upload a disk image such as a distribution's cloud image."
msgstr "Die Datei hat keine GUID-Partitionstabelle und ist daher kein UEFI-Datenträgerimage. Laden Sie ein Datenträgerimage hoch, etwa das Cloud-Image einer Distribution."

#: src/lib/serverMessages.ts
msgctxt "package.notZip"
msgid "The file is not a zip archive, or it is damaged. Upload a zip file."
msgstr "Die Datei ist keine ZIP-Datei oder beschädigt. Laden Sie eine ZIP-Datei hoch."

#: src/lib/serverMessages.ts
msgctxt "upload.length"
msgid "The file must not be empty and must fit on the server's store volume."
msgstr "Die Datei darf nicht leer sein und muss auf das Speichervolume des Servers passen."

#: src/lib/serverMessages.ts
msgctxt "upload.fileName"
msgid "The file name must have 1 to {max} characters and no control characters."
msgstr "Der Dateiname muss 1 bis {max} Zeichen und keine Steuerzeichen haben."

#: src/about/AboutPage.tsx
msgid "The GNU General Public License, version 3"
msgstr "Die GNU General Public License, Version 3"

#: src/settings/directory/GroupsAndRolesGroup.tsx
msgid "The group map needs it: while it is off, DDT reads no groups at all."
msgstr "Die Gruppenzuordnung braucht es: Solange es aus ist, liest DDT überhaupt keine Gruppen."

#: src/lib/serverMessages.ts
msgctxt "gpt.damaged"
msgid "The GUID partition table of the disk image is damaged."
msgstr "Die GUID-Partitionstabelle des Datenträgerimages ist beschädigt."

#: src/lib/serverMessages.ts
msgctxt "gpt.damagedHeader"
msgid "The GUID partition table of the disk image is damaged. Its header has a revision or size DDT does not know."
msgstr "Die GUID-Partitionstabelle des Datenträgerimages ist beschädigt. Ihr Header hat eine Revision oder Größe, die DDT nicht kennt."

#: src/lib/serverMessages.ts
msgctxt "gpt.damagedEntries"
msgid "The GUID partition table of the disk image is damaged. Its partition entries are laid out in a way DDT does not read."
msgstr "Die GUID-Partitionstabelle des Datenträgerimages ist beschädigt. Ihre Partitionseinträge sind so angeordnet, wie DDT sie nicht liest."

#: src/lib/serverMessages.ts
msgctxt "gpt.damagedUsableRange"
msgid "The GUID partition table of the disk image is damaged. Its usable range does not fit its own headers."
msgstr "Die GUID-Partitionstabelle des Datenträgerimages ist beschädigt. Ihr nutzbarer Bereich passt nicht zu ihren eigenen Headern."

#: src/lib/serverMessages.ts
msgctxt "gpt.damagedPartitionOutside"
msgid "The GUID partition table of the disk image is damaged. Partition {number} lies outside the usable sectors."
msgstr "Die GUID-Partitionstabelle des Datenträgerimages ist beschädigt. Partition {number} liegt außerhalb der nutzbaren Sektoren."

#: src/lib/serverMessages.ts
msgctxt "gpt.damagedOverlap"
msgid "The GUID partition table of the disk image is damaged. Partitions {first} and {second} overlap."
msgstr "Die GUID-Partitionstabelle des Datenträgerimages ist beschädigt. Die Partitionen {first} und {second} überlappen sich."

#: src/lib/serverMessages.ts
msgctxt "gpt.damagedEndsInTable"
msgid "The GUID partition table of the disk image is damaged. The file ends inside the partition table."
msgstr "Die GUID-Partitionstabelle des Datenträgerimages ist beschädigt. Die Datei endet innerhalb der Partitionstabelle."

#: src/runs/runs.ts
msgid "The hand-over to Windows began"
msgstr "Die Übergabe an Windows hat begonnen"

#: src/lib/serverMessages.ts
msgctxt "settings.oidc.signInScheme"
msgid "The handler would sign into ''{scheme}'', which bypasses local account linking entirely."
msgstr "Der Handler würde sich bei ''{scheme}'' anmelden, was die Verknüpfung mit lokalen Konten ganz umgeht."

#: src/lib/serverMessages.ts
msgctxt "sequence.shareHostFixed"
msgid "The host of a share can be made only of values fixed when the run starts, and {name} can change while it runs."
msgstr "Der Host einer Netzwerkfreigabe kann nur aus Werten bestehen, die beim Start der Ausführung feststehen, und {name} kann sich während der Ausführung ändern."

#: src/settings/signIn/ProviderGroup.tsx
msgid "The ID the provider shows for DDT's client."
msgstr "Die ID, die der Anbieter für den DDT-Client anzeigt."

#: src/lib/serverMessages.ts
msgctxt "sequence.imageBeforePartition"
msgid "The image can be applied only after a step that partitions the disk."
msgstr "Das Image kann erst nach einem Schritt angewendet werden, der den Datenträger partitioniert."

#: src/lib/serverMessages.ts
msgctxt "upload.conversionFailed"
msgid "The image could not be converted. {detail}"
msgstr "Das Image konnte nicht umgewandelt werden. {detail}"

#: src/lib/serverMessages.ts
msgctxt "sequence.imageGone"
msgid "The image is no longer in the library. Choose another image."
msgstr "Das Image ist nicht mehr in der Bibliothek. Wählen Sie ein anderes Image."

