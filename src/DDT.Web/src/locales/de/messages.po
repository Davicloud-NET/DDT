#: src/lib/serverMessages.ts
msgctxt "sequence.userDataFinalModulesWarning"
msgid "{how, select, missing {The user-data sets cloud_final_modules, and the list names neither scripts_vendor nor scripts-vendor, so cloud-init runs no vendor scripts.} other {DDT could not read what the user-data sets cloud_final_modules to. If the list does not name scripts_vendor, cloud-init runs no vendor scripts.}} DDT's script, which installs the agent in the installed Linux, is a vendor script, and without it the steps there never run. Add scripts_vendor to the list."
msgstr "{how, select, missing {Die Datei user-data setzt cloud_final_modules, und die Liste nennt weder scripts_vendor noch scripts-vendor, daher führt cloud-init keine Vendor-Skripte aus.} other {DDT konnte nicht lesen, worauf die Datei user-data cloud_final_modules setzt. Nennt die Liste scripts_vendor nicht, führt cloud-init keine Vendor-Skripte aus.}} Das Skript von DDT, das den Agent im installierten Linux installiert, ist ein Vendor-Skript, und ohne es laufen die Schritte dort nie. Nehmen Sie scripts_vendor in die Liste auf."

#: src/lib/serverMessages.ts
msgctxt "sequence.userDataVendorHandlersWarning"
msgid "{how, select, named {The user-data names text/x-shellscript in disabled_handlers under vendor_data, so cloud-init runs no shell script from vendor data.} other {DDT could not read what the user-data sets disabled_handlers under vendor_data to. If it names text/x-shellscript, cloud-init runs no shell script from vendor data.}} DDT's script, which installs the agent in the installed Linux, is a shell script, and without it the steps there never run. Leave text/x-shellscript out of disabled_handlers."
msgstr "{how, select, named {Die Datei user-data nennt text/x-shellscript in disabled_handlers unter vendor_data, daher führt cloud-init kein Shell-Skript aus den Vendor-Daten aus.} other {DDT konnte nicht lesen, worauf die Datei user-data disabled_handlers unter vendor_data setzt. Nennt disabled_handlers text/x-shellscript, führt cloud-init kein Shell-Skript aus den Vendor-Daten aus.}} Das Skript von DDT, das den Agent im installierten Linux installiert, ist ein Shell-Skript, und ohne es laufen die Schritte dort nie. Lassen Sie text/x-shellscript aus disabled_handlers heraus."

#: src/lib/serverMessages.ts
msgctxt "sequence.userDataVendorDataWarning"
msgid "{how, select, notMapping {The user-data sets vendor_data to something that is not a mapping, so cloud-init reads no vendor data.} notEnabled {The user-data sets enabled under vendor_data to something other than true, so cloud-init reads no vendor data.} other {DDT could not read what the user-data sets vendor_data to. It may switch vendor data off.}} DDT's agent gets into the installed Linux as vendor data, and without it the steps there never run. Leave vendor_data out, or set its enabled to true."
msgstr "{how, select, notMapping {Die Datei user-data setzt vendor_data auf etwas, das keine Zuordnung ist, daher liest cloud-init keine Vendor-Daten.} notEnabled {Die Datei user-data setzt enabled unter vendor_data auf etwas anderes als true, daher liest cloud-init keine Vendor-Daten.} other {DDT konnte nicht lesen, worauf die Datei user-data vendor_data setzt. Möglicherweise schaltet sie die Vendor-Daten ab.}} Der Agent von DDT kommt als Vendor-Daten ins installierte Linux, und ohne sie laufen die Schritte dort nie. Lassen Sie vendor_data weg, oder setzen Sie dessen enabled auf true."

