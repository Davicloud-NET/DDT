#: src/lib/serverMessages.ts
msgctxt "uefiCa.name"
msgid "{cas, select, ca2011 {Microsoft's third-party UEFI CA 2011} ca2023 {Microsoft's third-party UEFI CA 2023} both {Microsoft's third-party UEFI CAs 2011 and 2023} other {Microsoft's third-party UEFI CA}}"
msgstr "{cas, select, ca2011 {Microsofts UEFI-CA für Drittanbieter 2011} ca2023 {Microsofts UEFI-CA für Drittanbieter 2023} both {Microsofts UEFI-CAs für Drittanbieter 2011 und 2023} other {Microsofts UEFI-CA für Drittanbieter}}"

