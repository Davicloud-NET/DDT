msgid "The image list could not be loaded."
msgstr "Die Liste der Images konnte nicht geladen werden."

#: src/lib/serverMessages.ts
msgctxt "wim.listMismatch"
msgid "The image list in this WIM file does not match its header."
msgstr "Die Imageliste in dieser WIM-Datei passt nicht zu ihrem Header."

#: src/lib/serverMessages.ts
msgctxt "wim.listDamaged"
msgid "The image list in this WIM file is damaged."
msgstr "Die Imageliste in dieser WIM-Datei ist beschädigt."

#: src/lib/serverMessages.ts
msgctxt "wim.listNotUtf16"
msgid "The image list in this WIM file is not UTF-16 text, which DDT cannot read."
msgstr "Die Imageliste in dieser WIM-Datei ist kein UTF-16-Text, was DDT nicht lesen kann."

#: src/lib/serverMessages.ts
msgctxt "wim.listTooLarge"
msgid "The image list in this WIM file is too large."
msgstr "Die Imageliste in dieser WIM-Datei ist zu groß."

#: src/lib/serverMessages.ts
msgctxt "upload.diskFull"
msgid "The image store is full. Free space on the server's store volume, then continue the upload."
msgstr "Der Imagespeicher ist voll. Schaffen Sie Platz auf dem Speichervolume des Servers und setzen Sie den Upload dann fort."

#: src/lib/serverMessages.ts
msgctxt "upload.noSpace"
msgid "The image store needs {required} free for this upload but has {available}. Free space on the server's store volume or discard unfinished uploads, then try again."
msgstr "Der Imagespeicher braucht {required} freien Platz für diesen Upload, hat aber {available}. Schaffen Sie Platz auf dem Speichervolume des Servers oder verwerfen Sie unfertige Uploads, und versuchen Sie es dann erneut."

#: src/lib/serverMessages.ts
msgctxt "sequence.accountInputNoRunAs"
msgid "The input {input} does not let scripts run as the account given for it. Allow that in the input."
msgstr "Die Eingabe {input} lässt keine Skripts mit dem Konto laufen, das für sie angegeben wird. Erlauben Sie das in der Eingabe."

#: src/lib/serverMessages.ts
msgctxt "sequence.accountInputHostNotAllowed"
msgid "The input {input} does not let the account given for it connect to {host}. Add the server to the input."
msgstr "Die Eingabe {input} lässt das Konto, das für sie angegeben wird, nicht mit {host} verbinden. Fügen Sie den Server der Eingabe hinzu."

#: src/lib/serverMessages.ts
msgctxt "sequence.accountInputNoDomain"
msgid "The input {input} names no domain, so the account given for it cannot join one. Name the domain in the input."
msgstr "Die Eingabe {input} nennt keine Domäne, daher kann das Konto, das für sie angegeben wird, keiner beitreten. Nennen Sie die Domäne in der Eingabe."

