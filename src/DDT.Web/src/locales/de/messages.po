#: src/lib/serverMessages.ts
msgctxt "resolution.assignedOnWeb"
msgid "{by} assigned {sequence} on the web, which comes before every rule."
msgstr "{by} hat {sequence} im Web zugewiesen, was vor jeder Regel kommt."

#: src/runs/runs.ts
