msgid "The DHCP server has no scopes."
msgstr "Der DHCP-Server hat keine Bereiche."

#: src/lib/serverMessages.ts
msgctxt "directory.unreachable"
msgid "The directory at {server} could not be reached: {detail}"
msgstr "Das Verzeichnis unter {server} war nicht erreichbar: {detail}"

#: src/lib/serverMessages.ts
msgctxt "directory.bindAccountRefused"
msgid "The directory at {server} refused the bind account {bindDn}. Check the bind account and its password on the Sign-in page."
msgstr "Das Verzeichnis unter {server} hat das Bindungskonto {bindDn} abgelehnt. Prüfen Sie das Bindungskonto und sein Kennwort auf der Seite „Anmeldung“."

#: src/lib/serverMessages.ts
msgctxt "directory.baseDnRefused"
msgid "The directory at {server} refused the search under {baseDn}: {detail} Check the base DN on the Sign-in page."
msgstr "Das Verzeichnis unter {server} hat die Suche unter {baseDn} abgelehnt: {detail} Prüfen Sie den Basis-DN auf der Seite „Anmeldung“."

#: src/lib/serverMessages.ts
msgctxt "directory.connectionIncomplete"
msgid "The directory connection is not complete. Enter the directory server and the base DN on the Sign-in page."
msgstr "Die Verzeichnisverbindung ist unvollständig. Geben Sie den Verzeichnisserver und den Basis-DN auf der Seite „Anmeldung“ ein."

#: src/lib/serverMessages.ts
msgctxt "user.directoryProvidesNames"
msgid "The directory provides the display name and email address of {name}. Change them there; DDT takes them over at its next sign-in."
msgstr "Das Verzeichnis liefert den Anzeigenamen und die E-Mail-Adresse von {name}. Ändern Sie sie dort; DDT übernimmt sie bei der nächsten Anmeldung."

#: src/users/ChangeUserForm.tsx
msgid "The directory provides the name and email address."
msgstr "Das Verzeichnis liefert den Namen und die E-Mail-Adresse."

#: src/settings/directory/DirectorySettings.tsx
#: src/users/directory/DirectoryPanel.tsx
msgid "The directory settings could not be loaded."
msgstr "Die Verzeichniseinstellungen konnten nicht geladen werden."

#: src/lib/serverMessages.ts
msgctxt "directory.emptyMapNewAccount"
msgid "The directory's group map on the Sign-in page is empty, so administrators set roles. A first sign-in makes an account without one, which reaches nothing until an administrator gives it a role."
msgstr "Die Gruppenzuordnung des Verzeichnisses auf der Seite „Anmeldung“ ist leer, daher legen Administratoren die Rollen fest. Eine erste Anmeldung legt ein Konto ohne Rolle an, das nichts erreicht, bis ein Administrator ihm eine Rolle gibt."

#: src/lib/serverMessages.ts
msgctxt "directory.emptyMapRole"
msgid "The directory's group map on the Sign-in page is empty, so administrators set roles. The account has {role}."
msgstr "Die Gruppenzuordnung des Verzeichnisses auf der Seite „Anmeldung“ ist leer, daher legen Administratoren die Rollen fest. Das Konto hat die Rolle {role}."

#: src/lib/serverMessages.ts
msgctxt "directory.emptyMapNoRole"
msgid "The directory's group map on the Sign-in page is empty, so administrators set roles. The account has none yet, so it reaches nothing."
msgstr "Die Gruppenzuordnung des Verzeichnisses auf der Seite „Anmeldung“ ist leer, daher legen Administratoren die Rollen fest. Das Konto hat noch keine, daher erreicht es nichts."

#: src/lib/serverMessages.ts
msgctxt "sequence.partitionAfterImage"
msgid "The disk has to be partitioned before the image is applied."
msgstr "Der Datenträger muss partitioniert werden, bevor das Image angewendet wird."

#: src/lib/serverMessages.ts
msgctxt "gpt.incomplete"
msgid "The disk image holds {length} bytes, but its partitions reach to byte {end}. The file is incomplete."
msgstr "Das Datenträgerimage enthält {length} Bytes, aber seine Partitionen reichen bis Byte {end}. Die Datei ist unvollständig."

#: src/lib/serverMessages.ts
msgctxt "gpt.fourKilobyteSectors"
msgid "The disk image is made for disks with 4 KiB sectors. DDT writes images for disks with 512-byte sectors, which is what distributions publish."
msgstr "Das Datenträgerimage ist für Datenträger mit 4-KiB-Sektoren gemacht. DDT schreibt Images für Datenträger mit 512-Byte-Sektoren, wie Distributionen sie veröffentlichen."

#: src/boot/StaleReasonText.tsx
msgid "The drivers flagged for Windows PE have changed since it was built."
msgstr "Die für Windows PE markierten Treiber haben sich geändert, seit es erstellt wurde."

#: src/lib/serverMessages.ts
msgctxt "audit.rangeEnd"
msgid "The end of the range must come after its start."
msgstr "Das Ende des Zeitraums muss nach seinem Beginn liegen."

#: src/lib/serverMessages.ts
msgctxt "package.entryChecksum"
msgid "The entry {entry} does not unpack to the bytes the zip says it holds. Create the zip again."
msgstr "Der Eintrag {entry} entpackt nicht zu den Bytes, die die ZIP-Datei für ihn angibt. Erstellen Sie die ZIP-Datei neu."

#: src/lib/serverMessages.ts
msgctxt "package.entryForbiddenCharacter"
msgid "The entry {entry} has a character Windows does not allow in names, such as : for a drive or a data stream."
msgstr "Der Eintrag {entry} hat ein Zeichen, das Windows in Namen nicht erlaubt, etwa : für ein Laufwerk oder einen Datenstrom."

#: src/lib/serverMessages.ts
msgctxt "package.entryControlCharacter"
msgid "The entry {entry} has a control character in its name."
msgstr "Der Eintrag {entry} hat ein Steuerzeichen im Namen."

#: src/lib/serverMessages.ts
msgctxt "package.entryNameTooLong"
msgid "The entry {entry} has a name longer than {max} characters."
msgstr "Der Eintrag {entry} hat einen Namen mit mehr als {max} Zeichen."

#: src/lib/serverMessages.ts
msgctxt "package.entryTrailingDot"
msgid "The entry {entry} has a name that ends in a dot or a space, which Windows cannot create."
msgstr "Der Eintrag {entry} hat einen Namen, der auf einen Punkt oder ein Leerzeichen endet, was Windows nicht anlegen kann."

#: src/lib/serverMessages.ts
msgctxt "package.entryDeviceName"
msgid "The entry {entry} has a name Windows keeps for a device, such as CON or NUL."
msgstr "Der Eintrag {entry} hat einen Namen, den Windows für ein Gerät reserviert, etwa CON oder NUL."

#: src/lib/serverMessages.ts
msgctxt "package.entryEmptyName"
msgid "The entry {entry} has an empty name, or a folder name that points out of the package."
msgstr "Der Eintrag {entry} hat einen leeren Namen oder einen Ordnernamen, der aus dem Paket hinauszeigt."

#: src/lib/serverMessages.ts
msgctxt "package.entrySymbolicLink"
msgid "The entry {entry} is a symbolic link. Put the file itself in the zip."
msgstr "Der Eintrag {entry} ist ein symbolischer Link. Legen Sie die Datei selbst in die ZIP-Datei."

#: src/lib/serverMessages.ts
msgctxt "package.entryCompression"
msgid "The entry {entry} is compressed in a way DDT cannot unpack. Create the zip with Deflate."
msgstr "Der Eintrag {entry} ist so komprimiert, dass DDT ihn nicht entpacken kann. Erstellen Sie die ZIP-Datei mit Deflate."

#: src/lib/serverMessages.ts
msgctxt "package.entryDamaged"
msgid "The entry {entry} is damaged. Create the zip again."
msgstr "Der Eintrag {entry} ist beschädigt. Erstellen Sie die ZIP-Datei neu."

#: src/lib/serverMessages.ts
msgctxt "package.entryEncrypted"
msgid "The entry {entry} is encrypted. Upload a zip without a password."
msgstr "Der Eintrag {entry} ist verschlüsselt. Laden Sie eine ZIP-Datei ohne Kennwort hoch."

#: src/lib/serverMessages.ts
msgctxt "package.entryTwice"
msgid "The entry {entry} is in the zip twice, if case is ignored as Windows ignores it."
msgstr "Der Eintrag {entry} ist zweimal in der ZIP-Datei, wenn man wie Windows die Groß- und Kleinschreibung ignoriert."

#: src/lib/serverMessages.ts
msgctxt "package.entryTooDeep"
msgid "The entry {entry} is more than {max} folders deep."
msgstr "Der Eintrag {entry} liegt mehr als {max} Ordner tief."

#: src/lib/serverMessages.ts
msgctxt "package.entryAtRoot"
msgid "The entry {entry} starts at the root of a drive."
msgstr "Der Eintrag {entry} beginnt im Stammverzeichnis eines Laufwerks."

#: src/lib/serverMessages.ts
msgctxt "package.entrySize"
msgid "The entry {entry} unpacks to {actual} bytes, but the zip says {declared}. Create the zip again."
msgstr "Der Eintrag {entry} entpackt zu {actual} Bytes, aber die ZIP-Datei gibt {declared} an. Erstellen Sie die ZIP-Datei neu."

#: src/lib/serverMessages.ts
msgctxt "directory.noImmutableId"
msgid "The entry has no {attribute} value to key the account on, so a sign-in is refused."
msgstr "Der Eintrag hat keinen Wert {attribute}, an den das Konto gebunden werden kann, daher wird eine Anmeldung abgelehnt."

#: src/settings/networkBoot/SectionProblems.tsx
msgid "The fields marked below say what."
msgstr "Die markierten Felder unten sagen, welche."

