#: src/lib/serverMessages.ts
msgctxt "settings.pxe.bootDirectoryHoldsStore"
msgid "''{directory}'' holds DDT:StorePath, {store}, which would serve the database and the key ring. Use a directory of its own, such as {suggested}."
msgstr "''{directory}'' enthält DDT:StorePath, {store}, was die Datenbank und den Schlüsselbund ausliefern würde. Verwenden Sie ein eigenes Verzeichnis, etwa {suggested}."

#: src/lib/serverMessages.ts
msgctxt "settings.pxe.bootDirectoryHoldsKey"
msgid "''{directory}'' holds the folder of the TLS certificate or key {file}, which would serve the key. Use a directory of its own, such as {suggested}."
msgstr "''{directory}'' enthält den Ordner des TLS-Zertifikats oder -Schlüssels {file}, was den Schlüssel ausliefern würde. Verwenden Sie ein eigenes Verzeichnis, etwa {suggested}."

#: src/lib/serverMessages.ts
msgctxt "settings.pxe.bootDirectoryInKeys"
msgid "''{directory}'' is in the key ring folder {keys}, which would serve its keys. Use a directory of its own, such as {suggested}."
msgstr "''{directory}'' liegt im Schlüsselbundordner {keys}, was seine Schlüssel ausliefern würde. Verwenden Sie ein eigenes Verzeichnis, etwa {suggested}."

#: src/lib/serverMessages.ts
msgctxt "settings.pxe.bootDirectoryIsRoot"
msgid "''{directory}'' is the root of a filesystem, which would serve every file on it. Use a directory of its own, such as {suggested}."
msgstr "''{directory}'' ist das Stammverzeichnis eines Dateisystems, was jede Datei darauf ausliefern würde. Verwenden Sie ein eigenes Verzeichnis, etwa {suggested}."

#: src/lib/serverMessages.ts
msgctxt "sequence.keyboard"
msgid "''{keyboard}'' is not an input locale. Use a name such as de-DE or a code such as 0407:00000407."
msgstr "''{keyboard}'' ist kein Eingabegebietsschema. Verwenden Sie einen Namen wie de-DE oder einen Code wie 0407:00000407."

#: src/lib/serverMessages.ts
msgctxt "sequence.locale"
msgid "''{locale}'' is not a language and region that Windows knows. Use a name such as de-DE."
msgstr "''{locale}'' ist keine Sprache und Region, die Windows kennt. Verwenden Sie einen Namen wie de-DE."

#: src/lib/serverMessages.ts
msgctxt "namedValue.nameInvalid"
msgid "''{name}'' cannot name a value. Start with a letter, and use only letters, digits and _, at most {max} characters."
msgstr "''{name}'' kann keinen Wert benennen. Beginnen Sie mit einem Buchstaben, und verwenden Sie nur Buchstaben, Ziffern und _, höchstens {max} Zeichen."

#: src/lib/serverMessages.ts
msgctxt "settings.certificate.nameInvalid"
msgid "''{name}'' is not a host name or an address. Write each name alone, such as ddt.corp.example or 10.0.0.5."
msgstr "''{name}'' ist kein Hostname und keine Adresse. Schreiben Sie jeden Namen für sich, etwa ddt.corp.example oder 10.0.0.5."

#: src/lib/serverMessages.ts
msgctxt "settings.pxe.interfaceNotFound"
msgid "''{name}'' names no interface on {host}, which serves nothing for it."
msgstr "''{name}'' nennt keine Schnittstelle auf {host}, daher wird dafür nichts ausgeliefert."

#: src/lib/serverMessages.ts
msgctxt "settings.roleUnknown"
msgid "''{role}'' is not a DDT role. Use {roles}."
msgstr "''{role}'' ist keine DDT-Rolle. Verwenden Sie {roles}."

#: src/lib/serverMessages.ts
msgctxt "settings.oidc.provisionRoleUnknown"
msgid "''{role}'' is not a DDT role. Use {viewer} or {operator}."
msgstr "''{role}'' ist keine DDT-Rolle. Verwenden Sie {viewer} oder {operator}."

#: src/lib/serverMessages.ts
msgctxt "sequence.timeZone"
msgid "''{timeZone}'' is not a Windows time zone id. Use a name that tzutil /l lists, such as W. Europe Standard Time."
msgstr "''{timeZone}'' ist keine Windows-Zeitzonen-ID. Verwenden Sie einen Namen, den tzutil /l auflistet, etwa W. Europe Standard Time."

#: src/lib/serverMessages.ts
msgctxt "settings.proxies.networkEverything"
msgid "''{value}'' is every address there is, so any client could claim any address. Name the proxies' own network."
msgstr "''{value}'' umfasst jede Adresse, die es gibt, daher könnte jeder Client jede Adresse vorgeben. Nennen Sie das eigene Netzwerk der Proxys."

#: src/lib/serverMessages.ts
msgctxt "settings.machines.networkEverything"
msgid "''{value}'' is every address there is. Name the provisioning networks themselves."
msgstr "''{value}'' umfasst jede Adresse, die es gibt. Nennen Sie die Bereitstellungsnetzwerke selbst."

#: src/lib/serverMessages.ts
msgctxt "settings.pxe.architectureUnknown"
msgid "''{value}'' is not a client architecture. Use one of: {architectures}."
msgstr "''{value}'' ist keine Client-Architektur. Verwenden Sie eine von: {architectures}."

#: src/lib/serverMessages.ts
msgctxt "settings.deployment.localeUnknown"
msgid "''{value}'' is not a culture name. Use one such as de-DE or en-US, or leave it empty for the image's own language."
msgstr "''{value}'' ist kein Kulturname. Verwenden Sie einen wie de-DE oder en-US, oder lassen Sie ihn leer für die eigene Sprache des Images."

#: src/lib/serverMessages.ts
msgctxt "organizationalUnit.notDistinguished"
msgid "''{value}'' is not a distinguished name. Write it like OU=Workstations,DC=example,DC=com."
msgstr "''{value}'' ist kein Distinguished Name. Schreiben Sie ihn wie OU=Workstations,DC=example,DC=com."

#: src/lib/serverMessages.ts
msgctxt "stepAccount.domainInvalid"
msgid "''{value}'' is not a domain name. Enter one such as corp.example, or leave it empty."
msgstr "''{value}'' ist kein Domänenname. Geben Sie einen wie corp.example ein, oder lassen Sie das Feld leer."

#: src/lib/serverMessages.ts
msgctxt "settings.deployment.controllerInvalid"
msgid "''{value}'' is not a host name or an address. Name the domain controller alone, such as dc1.corp.example or 10.0.0.10, without a scheme or a port."
msgstr "''{value}'' ist kein Hostname und keine Adresse. Nennen Sie nur den Domänencontroller, etwa dc1.corp.example oder 10.0.0.10, ohne Schema und Port."

#: src/lib/serverMessages.ts
msgctxt "settings.deployment.consoleLanguageUnknown"
msgid "''{value}'' is not a language the console at the machine speaks. Use en or de, or leave it empty for the language of Windows PE."
msgstr "''{value}'' ist keine Sprache, die die Konsole am Gerät spricht. Verwenden Sie en oder de, oder lassen Sie das Feld leer, damit sie die Sprache von Windows PE spricht."

#: src/lib/serverMessages.ts
msgctxt "settings.logging.levelUnknown"
msgid "''{value}'' is not a log level. Use Trace, Debug, Information, Warning, Error, Critical or None."
msgstr "''{value}'' ist keine Protokollstufe. Verwenden Sie Trace, Debug, Information, Warning, Error, Critical oder None."

#: src/lib/serverMessages.ts
msgctxt "settings.proxies.networkInvalid"
msgid "''{value}'' is not a network such as 10.20.0.0/24 with no address bits set past the prefix length."
msgstr "''{value}'' ist kein Netzwerk wie 10.20.0.0/24 ohne gesetzte Adressbits nach der Präfixlänge."

#: src/lib/serverMessages.ts
msgctxt "settings.machines.networkInvalid"
msgid "''{value}'' is not a network. Write each one as an address and a prefix length with no address bits set after the prefix, such as 10.20.0.0/16, fd00:20::/64 or 10.20.1.5/32 for one machine."
msgstr "''{value}'' ist kein Netzwerk. Schreiben Sie jedes als Adresse und Präfixlänge ohne gesetzte Adressbits nach dem Präfix, etwa 10.20.0.0/16, fd00:20::/64 oder 10.20.1.5/32 für ein Gerät."

#: src/lib/serverMessages.ts
msgctxt "stepAccount.hostInvalid"
msgid "''{value}'' is not a server name. Enter it as share paths name it, such as files.corp.example."
msgstr "''{value}'' ist kein Servername. Geben Sie ihn so ein, wie ihn die Pfade der Netzwerkfreigaben nennen, etwa files.corp.example."

#: src/lib/serverMessages.ts
msgctxt "settings.deployment.administratorNameInvalid"
msgid "''{value}'' is not a valid account name. Use 1 to {max} characters and none of \" / \\ [ ] : ; | = , + * ? < >."
msgstr "''{value}'' ist kein gültiger Kontoname. Verwenden Sie 1 bis {max} Zeichen und keines von \" / \\ [ ] : ; | = , + * ? < >."

#: src/lib/serverMessages.ts
msgctxt "settings.deployment.timeZoneUnknown"
msgid "''{value}'' is not a Windows time zone id. Use a name that tzutil /l lists, such as W. Europe Standard Time, or leave it empty so that Windows picks the zone of the locale."
msgstr "''{value}'' ist keine Windows-Zeitzonen-ID. Verwenden Sie einen Namen, den tzutil /l auflistet, etwa W. Europe Standard Time, oder lassen Sie sie leer, damit Windows die Zone des Gebietsschemas wählt."

#: src/lib/serverMessages.ts
msgctxt "settings.proxies.addressInvalid"
msgid "''{value}'' is not an IP address."
msgstr "''{value}'' ist keine IP-Adresse."

#: src/lib/serverMessages.ts
msgctxt "settings.pxe.notIpv4Address"
msgid "''{value}'' is not an IPv4 address."
msgstr "''{value}'' ist keine IPv4-Adresse."

#: src/lib/serverMessages.ts
msgctxt "deployment.answerNotAChoice"
msgid "''{value}'' is not one of the choices of {label}."
msgstr "''{value}'' ist keine der Auswahlmöglichkeiten von {label}."

#: src/lib/serverMessages.ts
msgctxt "settings.deployment.domainUserNameForm"
msgid "''{value}'' must be written as DOMAIN\\user or user@domain.example."
msgstr "''{value}'' muss als DOMAIN\\user oder user@domain.example geschrieben werden."

