#: src/lib/serverMessages.ts
msgctxt "settings.pxe.bootDirectoryHoldsStore"
msgid "''{directory}'' holds DDT:StorePath, {store}, which would serve the database and the key ring. Use a directory of its own, such as {suggested}."
msgstr "''{directory}'' holds DDT:StorePath, {store}, which would serve the database and the key ring. Use a directory of its own, such as {suggested}."

#: src/lib/serverMessages.ts
msgctxt "settings.pxe.bootDirectoryHoldsKey"
msgid "''{directory}'' holds the folder of the TLS certificate or key {file}, which would serve the key. Use a directory of its own, such as {suggested}."
msgstr "''{directory}'' holds the folder of the TLS certificate or key {file}, which would serve the key. Use a directory of its own, such as {suggested}."

#: src/lib/serverMessages.ts
msgctxt "settings.pxe.bootDirectoryInKeys"
msgid "''{directory}'' is in the key ring folder {keys}, which would serve its keys. Use a directory of its own, such as {suggested}."
msgstr "''{directory}'' is in the key ring folder {keys}, which would serve its keys. Use a directory of its own, such as {suggested}."

#: src/lib/serverMessages.ts
msgctxt "settings.pxe.bootDirectoryIsRoot"
msgid "''{directory}'' is the root of a filesystem, which would serve every file on it. Use a directory of its own, such as {suggested}."
msgstr "''{directory}'' is the root of a filesystem, which would serve every file on it. Use a directory of its own, such as {suggested}."

#: src/lib/serverMessages.ts
msgctxt "sequence.keyboard"
msgid "''{keyboard}'' is not an input locale. Use a name such as de-DE or a code such as 0407:00000407."
msgstr "''{keyboard}'' is not an input locale. Use a name such as de-DE or a code such as 0407:00000407."

#: src/lib/serverMessages.ts
msgctxt "sequence.locale"
msgid "''{locale}'' is not a language and region that Windows knows. Use a name such as de-DE."
msgstr "''{locale}'' is not a language and region that Windows knows. Use a name such as de-DE."

#: src/lib/serverMessages.ts
msgctxt "settings.certificate.nameInvalid"
msgid "''{name}'' is not a host name or an address. Write each name alone, such as ddt.corp.example or 10.0.0.5."
msgstr "''{name}'' is not a host name or an address. Write each name alone, such as ddt.corp.example or 10.0.0.5."

