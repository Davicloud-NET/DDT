<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\DDT.Agent\DDT.Agent.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The fakes and other helpers of DDT.Agent.Core.Tests, which the tests here use too, so each exists once. Every
         file there that is not a test class is one. -->
    <Compile Include="..\DDT.Agent.Core.Tests\*.cs" Exclude="..\DDT.Agent.Core.Tests\*Tests.cs" LinkBase="Shared" />
  </ItemGroup>

</Project>
